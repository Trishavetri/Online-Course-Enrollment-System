package logic;

import db.DBConnection;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.Statement;

public class EnrollmentSystem {

    public static String[] getCourses() {

        try {

            Connection con =
                    DBConnection.getConnection();

            Statement st =
                    con.createStatement();

            ResultSet rs =
                    st.executeQuery(
                            "SELECT course_name FROM courses"
                    );

            String[] courses =
                    new String[10];

            int i = 0;

            while (rs.next()) {

                courses[i] =
                        rs.getString("course_name");

                i++;
            }

            return courses;

        } catch (Exception e) {

            e.printStackTrace();
        }

        return new String[]{};
    }

    public static boolean enrollCourse(
            String username,
            String course
    ) {

        try {

            Connection con =
                    DBConnection.getConnection();

            String check =
                    "SELECT * FROM enrollments WHERE username=? AND course_name=?";

            PreparedStatement cps =
                    con.prepareStatement(check);

            cps.setString(1, username);

            cps.setString(2, course);

            ResultSet rs =
                    cps.executeQuery();

            if (rs.next()) {

                return false;
            }

            String sql =
                    "INSERT INTO enrollments(username,course_name) VALUES(?,?)";

            PreparedStatement ps =
                    con.prepareStatement(sql);

            ps.setString(1, username);

            ps.setString(2, course);

            ps.executeUpdate();

            return true;

        } catch (Exception e) {

            e.printStackTrace();
        }

        return false;
    }

    public static String trackEnrollments() {

        StringBuilder sb =
                new StringBuilder();

        try {

            Connection con =
                    DBConnection.getConnection();

            Statement st =
                    con.createStatement();

            ResultSet rs =
                    st.executeQuery(
                            "SELECT * FROM enrollments"
                    );

            while (rs.next()) {

                sb.append("User : ")
                        .append(rs.getString("username"))
                        .append("\n");

                sb.append("Course : ")
                        .append(rs.getString("course_name"))
                        .append("\n");

                sb.append("------------------\n");
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return sb.toString();
    }
}
